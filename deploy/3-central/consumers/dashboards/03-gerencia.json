{
  "uid": "greytec-gerencia",
  "title": "Greytec — Gerencia",
  "description": "Tendencias de negocio: OEE y sus componentes, producción diaria, energía e intensidad energética. Fuentes: v_oee_hourly, v_production_hourly, v_energy_hourly, v_energy_intensity_hourly, v_line_availability_hourly.",
  "tags": ["greytec-demo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "graphTooltip": 1,
  "editable": true,
  "refresh": "5m",
  "time": { "from": "now-30d", "to": "now" },
  "templating": { "list": [] },
  "links": [
    {
      "type": "dashboards",
      "title": "Vistas",
      "tags": ["greytec-demo"],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "OEE del período",
      "description": "Promedio de v_oee_hourly en el rango visible. Referencia industria: 60-85%.",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 70 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(avg(oee_pct)::numeric, 1) AS \"OEE\" FROM v_oee_hourly WHERE $__timeFilter(hour)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Producción del período",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(sum(produced), 0) AS \"Botellas\" FROM v_production_hourly WHERE $__timeFilter(hour)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Disponibilidad del período",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 75 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(avg(availability_pct)::numeric, 1) AS \"Disponibilidad\" FROM v_line_availability_hourly WHERE $__timeFilter(hour)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Energía del período",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(coalesce(sum(kwh), 0)::numeric, 1) AS \"kWh\" FROM v_energy_hourly WHERE $__timeFilter(hour)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "OEE y componentes",
      "description": "OEE = disponibilidad × calidad × performance (v_oee_hourly). El componente que cae explica el porqué del OEE.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 110,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "auto", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "OEE" },
            "properties": [
              { "id": "custom.lineWidth", "value": 3 },
              { "id": "custom.fillOpacity", "value": 15 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT hour AS time, oee_pct AS \"OEE\", availability_pct AS \"Disponibilidad\", quality_pct AS \"Calidad\", performance_pct AS \"Performance\" FROM v_oee_hourly WHERE $__timeFilter(hour) ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Producción por día",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Buenas" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Rechazadas" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 day', hour) AS time, sum(good) AS \"Buenas\", sum(rejected) AS \"Rechazadas\" FROM v_production_hourly WHERE $__timeFilter(hour) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Energía por día (kWh)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 day', hour) AS time, round(sum(kwh)::numeric, 2) AS \"kWh\" FROM v_energy_hourly WHERE $__timeFilter(hour) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Intensidad energética (Wh por botella)",
      "description": "v_energy_intensity_hourly (gold). Sube cuando la celda consume sin producir — paradas, fallas, arranques. El argumento de eficiencia del demo.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: Wh/bot",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT hour AS time, wh_per_bottle AS \"Wh/botella\" FROM v_energy_intensity_hourly WHERE $__timeFilter(hour) ORDER BY 1"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disponibilidad por día (%)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "auto", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 day', hour) AS time, round(avg(availability_pct)::numeric, 1) AS \"Disponibilidad\" FROM v_line_availability_hourly WHERE $__timeFilter(hour) GROUP BY 1 ORDER BY 1"
        }
      ]
    }
  ]
}