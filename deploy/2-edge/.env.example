# ─── Stack edge IOT2050 — plantilla de credenciales ─────────────────────────
# Copiar a .env y rellenar. El .env real NO se versiona (ver .gitignore).
#
#   cp .env.example .env

# EMQX central (VLAN DMZ) — destino del bridge NanoMQ
EMQX_CENTRAL_HOST=10.10.20.130
EMQX_CENTRAL_PORT=1883

# Usuario del bridge en EMQX central (Built-in DB; Publish Allow sobre greytec/#)
# Compartido entre dispositivos edge (no requiere alta manual por unidad en el
# Dashboard de EMQX — ver gobernanza: config clicada no versiona en el repo).
BRIDGE_USERNAME=iot2050-bridge
BRIDGE_PASSWORD=changeme

# Client ID del bridge MQTT — DEBE ser único por dispositivo físico. Si dos
# equipos se conectan a EMQX central con el mismo clientid, el broker
# desconecta silenciosamente al primero (comportamiento estándar de MQTT ante
# clientid duplicado). Convención sugerida: nanomq-iot2050-<identificador-del-sitio-o-serial>-bridge
BRIDGE_CLIENT_ID=nanomq-iot2050-CAMBIAR-bridge

# Secreto para cifrar credenciales de Node-RED (flows_cred.json)
NODE_RED_CREDENTIAL_SECRET=changeme
